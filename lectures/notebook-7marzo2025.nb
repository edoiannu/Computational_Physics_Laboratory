Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "    ", 
   RowBox[{"integrale", " ", "di", " ", "un", " ", "polinomio"}], "   ", 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"myInt", "[", " ", 
     RowBox[{"expr_", ",", " ", "var_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", " ", 
     RowBox[{
      RowBox[{"{", "temp", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"temp", " ", "=", " ", 
        RowBox[{"Expand", "[", "expr", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "temp", "]"}], "===", "Plus"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"risultato", " ", "=", " ", 
          RowBox[{"Map", "[", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"intmonomio", "[", " ", 
              RowBox[{"#", ",", " ", "var"}], "]"}], "&"}], ",", " ", 
            "temp"}], "]"}]}], ",", "\[IndentingNewLine]", "True", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"risultato", " ", "=", " ", 
          RowBox[{"intmonomio", "[", 
           RowBox[{"temp", ",", " ", "var"}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "risultato"}]}], "\[IndentingNewLine]", "]"}]}],
