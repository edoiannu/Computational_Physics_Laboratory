Cell[BoxData[
 RowBox[{
  RowBox[{"-", "EulerGamma"}], "+", 
  FractionBox["1", "x"], "+", 
  RowBox[{
   FractionBox["1", "12"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"6", " ", 
      SuperscriptBox["EulerGamma", "2"]}], "+", 
     SuperscriptBox["\[Pi]", "2"]}], ")"}], " ", "x"}], "+", 
  RowBox[{
   FractionBox["1", "6"], " ", 
   SuperscriptBox["x", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["EulerGamma", "3"]}], "-", 
     FractionBox[
      RowBox[{"EulerGamma", " ", 
       SuperscriptBox["\[Pi]", "2"]}], "2"], "+", 
     RowBox[{"PolyGamma", "[", 
      RowBox[{"2", ",", "1"}], "]"}]}], ")"}]}]}]], "Output",
