Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"intmonomio", "[", 
    RowBox[{"expr_", ",", "var_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "temp", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"expr", ",", " ", 
          RowBox[{"p_.", " ", 
           RowBox[{"var", "^", "n_."}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"prefattore", " ", "=", " ", 
          RowBox[{"expr", " ", "/.", " ", 
           RowBox[{
            RowBox[{"p_.", " ", 
             RowBox[{"var", "^", "n_."}]}], " ", "\[Rule]", " ", "p"}]}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"esponente", " ", "=", " ", 
          RowBox[{"expr", " ", "/.", " ", 
           RowBox[{
            RowBox[{"p_.", " ", 
             RowBox[{"var", "^", "n_."}]}], " ", "\[Rule]", " ", "n"}]}]}], 
         ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{"expr", ",", " ", 
           RowBox[{"p_.", " ", 
            RowBox[{"var", "^", "n_."}]}]}], "]"}], " ", "&&", " ", 
         RowBox[{"FreeQ", "[", " ", 
          RowBox[{"prefattore", ",", " ", "var"}], "]"}], " ", "&&", " ", 
         RowBox[{"FreeQ", "[", " ", 
          RowBox[{"esponente", ",", " ", "var"}], "]"}], " ", "&&", " ", 
         RowBox[{"esponente", " ", "=!=", 
          RowBox[{"-", "1"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"risultato", " ", "=", " ", 
         RowBox[{"prefattore", " ", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"esponente", "+", "1"}], ")"}]}], " ", 
          RowBox[{"var", "^", 
           RowBox[{"(", 
            RowBox[{"esponente", "+", "1"}], ")"}]}]}]}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{"expr", ",", " ", 
           RowBox[{"p_.", " ", 
            RowBox[{"var", "^", "n_."}]}]}], "]"}], " ", "&&", " ", 
         RowBox[{"FreeQ", "[", " ", 
