Cell[BoxData[
 RowBox[{
  RowBox[{"selezione", "[", "pop_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "temp", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"voti", " ", "=", " ", 
      RowBox[{"Map", "[", " ", 
       RowBox[{"fitness", ",", " ", "pop"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sommavoti", " ", "=", " ", 
      RowBox[{"Plus", " ", "@@", " ", "voti"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"frazioni", " ", "=", " ", 
      RowBox[{"voti", " ", "/", " ", "sommavoti"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"intervalli", " ", "=", " ", 
      RowBox[{"Table", "[", "  ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"frazioni", " ", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "1", ",", " ", "i"}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Npop"}], "}"}]}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"genitori", " ", "=", " ", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "\t\t\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{"r", " ", "=", " ", "Random"}], ";", "\[IndentingNewLine]", 
         "ciam"}], ",", "\[IndentingNewLine]", "\t\t\t\t", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Npop"}], "}"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.951455068244369*^9, 3.9514550697860117`*^9}, {
