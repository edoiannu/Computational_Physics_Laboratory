Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"f", "[", "x0", "]"}], "+", 
   RowBox[{
    RowBox[{
     SuperscriptBox["f", "\[Prime]",
      MultilineFunction->None], "[", "x0", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"x", "-", "x0"}], ")"}]}], "+", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{
     SuperscriptBox["f", "\[Prime]\[Prime]",
      MultilineFunction->None], "[", "x0", "]"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}], "2"]}], "+", 
   RowBox[{
    FractionBox["1", "6"], " ", 
    RowBox[{
     SuperscriptBox["f", 
      TagBox[
       RowBox[{"(", "3", ")"}],
       Derivative],
      MultilineFunction->None], "[", "x0", "]"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}], "3"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"x", "-", "x0"}], "]"}], "4"],
    SeriesData[$CellContext`x, $CellContext`x0, {}, 0, 4, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, $CellContext`x0, {
    $CellContext`f[$CellContext`x0], 
