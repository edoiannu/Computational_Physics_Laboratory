Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Restituisce", " ", "la", " ", "lista", " ", "degli", " ", "impulsi", " ", 
    "associati", " ", "alle", " ", "linee", " ", "del", " ", "grafo"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"listaimpulsi", "[", "grafo_", "]"}], ":=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Apply", "[", 
        RowBox[{"p", ",", "#"}], "]"}], "&"}], ",", "grafo"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Sostituisce", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", "j"}], "}"}], " ", "con", " ", 
     RowBox[{"p", "[", 
      RowBox[{"i", ",", "j"}], "]"}], " ", "nel", " ", "primo", " ", 
     "elemento", " ", "di", " ", "ogni", " ", "coppia"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"applicaimpulsi", "[", "grafo_", "]"}], ":=", 
    RowBox[{"MapAt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Apply", "[", 
        RowBox[{"p", ",", "#"}], "]"}], "&"}], ",", "grafo", ",", 
      RowBox[{"{", 
       RowBox[{"All", ",", "1"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Genera", " ", "le", " ", "equazioni", " ", "di", " ", "conservazione", " ",
      "del", " ", "momento", " ", "per", " ", "ogni", " ", "vertice"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"generaequazioni", "[", "grafo_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "temp", "}"}], ",", 
       RowBox[{
        RowBox[{"indici", "=", 
         RowBox[{"Flatten", "[", "grafo", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"npt", "=", 
         RowBox[{"Max", "[", "indici", "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"numero", " ", "di", " ", "punti", " ", "esterni"}], "*)"}], 
        
        RowBox[{"nvert", "=", 
         RowBox[{"Min", "[", "indici", "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"numero", " ", "di", " ", "vertici"}], "*)"}], 
        RowBox[{"impulsi", "=", 
         RowBox[{"listaimpulsi", "[", "grafo", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Conservazione", " ", "del", " ", "momento", " ", "per", " ", 
          "ciascun", " ", "vertice"}], "*)"}], 
        RowBox[{"equazioni", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"impulsivertice", "=", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"Cases", "[", 
                RowBox[{"impulsi", ",", 
                 RowBox[{"p", "[", 
                  RowBox[{"_", ",", "i"}], "]"}]}], "]"}], ",", 
               RowBox[{"-", 
                RowBox[{"Cases", "[", 
                 RowBox[{"impulsi", ",", 
                  RowBox[{"p", "[", 
                   RowBox[{"i", ",", "_"}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"eq", "=", 
             RowBox[{
              RowBox[{"Apply", "[", 
               RowBox[{"Plus", ",", "impulsivertice"}], "]"}], "==", 
              "0"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"-", "1"}], ",", "nvert", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Rinomina", " ", 
           RowBox[{"p", "[", 
            RowBox[{"i", ",", "j"}], "]"}]}], "->", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "[", "i", "]"}], " ", "se", " ", "i"}], ">", "0"}]}],
          "*)"}], 
        RowBox[{"equazioni", "=", 
         RowBox[{"equazioni", "/.", " ", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{
             RowBox[{"i_", "/;", 
              RowBox[{"i", ">", "0"}]}], ",", "j_"}], "]"}], ":>", 
           RowBox[{"p", "[", "i", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Impulsi", " ", "interni"}], "=", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"i", ",", "j"}], "]"}], " ", "non", " ", "rinominati"}]}],
          "*)"}], 
        RowBox[{"incognite", "=", 
         RowBox[{"Cases", "[", 
          RowBox[{"equazioni", ",", 
           RowBox[{"p", "[", 
            RowBox[{"_", ",", "_"}], "]"}], ",", "Infinity"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Conservazione", " ", 
           RowBox[{"globale", ":", "p_n"}]}], "=", 
          RowBox[{"-", "\[CapitalSigma]p_i"}]}], "*)"}], 
        RowBox[{"globale", "=", 
         RowBox[{"Rule", "[", 
          RowBox[{
           RowBox[{"p", "[", "npt", "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"p", "[", "k", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", 
                RowBox[{"npt", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"equazioni", "=", 
         RowBox[{"equazioni", "/.", " ", "globale"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"impulsiinterni", "=", 
         RowBox[{"Solve", "[", 
          RowBox[{"equazioni", ",", "incognite"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "impulsiinterni", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Aggiunge", " ", "indici", " ", "di", " ", "Lorentz", " ", "e", " ", 
     "colore", " ", "a", " ", "ciascuna", " ", "linea"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"addIndices", "[", "grafo_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "newgrafo", "}"}], ",", 
       RowBox[{"newgrafo", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"grafo", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"mu", "[", 
             RowBox[{"grafo", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"c", "[", 
             RowBox[{"grafo", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"grafo", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], "<", "0"}], ",", 
              RowBox[{"Sequence", "@@", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"mu", "[", 
                  RowBox[{"grafo", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], ",", 
                 RowBox[{"c", "[", 
                  RowBox[{"grafo", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], ",",
               "Nothing"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "grafo", "]"}]}], "}"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Costruisce", " ", 
     RowBox[{"l", "'"}], "espressione", " ", "associata", " ", "a", " ", "un",
      " ", "grafo"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"diagramma", "[", "grafo_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"numeriinterni", ",", "newgrafo"}], "}"}], ",", 
       RowBox[{
        RowBox[{"newgrafo", "=", 
         RowBox[{"addIndices", "[", "grafo", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"regole", "=", 
         RowBox[{"generaequazioni", "[", "grafo", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Linee", " ", "interne", " ", "del", " ", "grafo"}], "*)"}], 
        
        RowBox[{"interne", "=", 
         RowBox[{"Cases", "[", 
          RowBox[{"newgrafo", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i_", "/;", 
                RowBox[{"i", "<", "0"}]}], ",", 
               RowBox[{"j_", "/;", 
                RowBox[{"j", "<", "0"}]}]}], "}"}], ",", "___"}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"numeriinterni", "=", 
         RowBox[{
          RowBox[{"applicaimpulsi", "[", "interne", "]"}], "/.", " ", 
          RowBox[{"regole", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"propagatori", "=", 
         RowBox[{"Apply", "[", 
          RowBox[{"Times", ",", 
           RowBox[{"Map", "[", 
            RowBox[{"Prop", ",", "numeriinterni"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Vertici", ":", 
          RowBox[{
           RowBox[{"calcolo", " ", "momento"}], "+", 
           RowBox[{"indici", " ", "per", " ", "ciascun", " ", "vertice"}]}]}],
          "*)"}], 
        RowBox[{"vertici", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"linee", "=", 
             RowBox[{"applicaimpulsi", "[", "newgrafo", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"lineevertice", "=", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"Cases", "[", 
                RowBox[{"linee", ",", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"a_", ",", "i"}], "]"}], ",", "rest___"}], "}"}], 
                  ":>", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"a", ",", "i"}], "]"}], ",", "rest"}], "}"}]}]}], 
                "]"}], ",", 
               RowBox[{"Cases", "[", 
                RowBox[{"linee", ",", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"i", ",", "b_"}], "]"}], ",", "rest___"}], "}"}], 
                  ":>", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", 
                    RowBox[{"p", "[", 
                    RowBox[{"i", ",", "b"}], "]"}]}], ",", "rest"}], 
                   "}"}]}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"lineevertice", "=", 
             RowBox[{"lineevertice", "/.", " ", 
              RowBox[{"regole", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"lineevertice", "=", 
             RowBox[{"lineevertice", "/.", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"p", "[", 
                  RowBox[{
                   RowBox[{"i_", "/;", 
                    RowBox[{"i", ">", "0"}]}], ",", "j_"}], "]"}], ",", 
                 "rest___"}], "}"}], ":>", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"p", "[", "i", "]"}], ",", "rest"}], "}"}]}]}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"lineevertice", "=", 
             RowBox[{"lineevertice", "/.", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"momentum___", ",", 
                 RowBox[{"mu", "[", "j_", "]"}], ",", 
                 RowBox[{"c", "[", "j_", "]"}], ",", 
                 RowBox[{"mu", "[", "k_", "]"}], ",", 
                 RowBox[{"c", "[", "k_", "]"}]}], "}"}], ":>", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"j", "===", "i"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"momentum", ",", 
                   RowBox[{"mu", "[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"k", ">", "0"}], ",", "k", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "i"}], "}"}]}], "]"}], "]"}], ",", 
                   RowBox[{"c", "[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"k", ">", "0"}], ",", "k", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "i"}], "}"}]}], "]"}], "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"momentum", ",", 
                   RowBox[{"mu", "[", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "i"}], "}"}], "]"}], ",", 
                   RowBox[{"c", "[", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "i"}], "}"}], "]"}]}], "}"}]}], 
                "]"}]}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"vertice", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "lineevertice", "]"}], "===", "3"}], ",", 
               RowBox[{
                RowBox[{"V3", "[", "i", "]"}], "[", "lineevertice", "]"}], ",", 
               RowBox[{
                RowBox[{"V4", "[", "i", "]"}], "[", "lineevertice", "]"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", "vertice"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"-", "1"}], ",", "nvert", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vertici", "=", 
         RowBox[{"Apply", "[", 
          RowBox[{"Times", ",", "vertici"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"propagatori", "*", "vertici"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
