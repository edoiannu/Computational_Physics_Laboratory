Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"UnpolSquaredAmplitude", "[", "next_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "appo", ",", " ", "temp", ",", " ", "start", ",", " ", "stop", ",", 
        " ", "d", ",", " ", "M", ",", " ", "contrM", ",", " ", "Mdag", ",", 
        " ", "MdagM", ",", "  ", "ncolorf", ",", "  ", "colorf", ",", " ", 
        "colorfdag", ",", " ", "npart", ",", " ", "contrparts", ",", " ", 
        "partsdag", ",", " ", "parts", ",", " ", "result", ",", " ", "tf", ",",
         " ", "ti"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"start", " ", "=", " ", 
        RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Computation unpolarized squared amplitude for \>\"", " ",
          "<>", " ", 
         RowBox[{"ToString", "[", "2", "]"}], " ", "<>", " ", "\"\< -> \>\"", 
         " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"next", "-", "2"}], "]"}], " ", "<>", 
         " ", "\"\< using dependent colour sub-amplitudes...\>\""}], "]"}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"generadiagrammi", "[", 
         RowBox[{"next", ",", " ", "grafobase"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"M", " ", "=", " ", 
        RowBox[{"ParallelMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", " ", "//", " ", "FeynRules"}], " ", "//", "  ", 
               "ExpandLorentz"}], " ", "//", " ", "Expand"}], "  ", "//", " ",
              "LorentzSPinternal"}], " ", ")"}], " ", "&"}], ",", " ", "d", ",",
           " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<FinestGrained\>\""}]}], " ", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"M", " ", "=", " ", 
        RowBox[{"colourSubstructures", "[", 
         RowBox[{"M", ",", " ", "next"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"colorf", " ", "=", " ", 
        RowBox[{"colourFactors", "[", 
         RowBox[{"M", ",", " ", "next"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"M", " ", "=", " ", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"Total", "[", "M", "]"}], ",", "i"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "colorf"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ncolorf", " ", "=", " ", 
        RowBox[{"Length", "[", "colorf", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"colorf", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"colorf", " ", "/.", " ", 
            RowBox[{"newDecomp", "[", 
             RowBox[{"colorf", ",", " ", "next"}], "]"}]}], " ", "/.", " ", 
           RowBox[{"reorderIndices", "[", "next", "]"}]}], ")"}], " ", "//", 
         " ", "adjRepr"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"colorfdag", " ", "=", " ", 
        RowBox[{"complexConjugate", "[", "colorf", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"colorf", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"j", ">=", " ", "i"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"colorf", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{"colorfdag", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], " ", "//", " ", "Expand"}],
               ",", " ", "0"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", "ncolorf"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", "1", ",", " ", "ncolorf"}], "}"}]}], 
           "]"}], " ", "//", " ", "matrixProduct"}], " ", "//", " ", 
         "traceOperations"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"colorf", " ", "=", " ", 
        RowBox[{"colorf", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{"N", " ", ":>", " ", "3"}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Mdag", " ", "=", " ", 
        RowBox[{"complexConjugate", "[", "M", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"contrM", " ", "=", " ", 
        RowBox[{"extpolContraction", "[", 
         RowBox[{"M", ",", " ", "next"}], "]"}]}], ";", "\[IndentingNewLine]",
        "\[IndentingNewLine]", 
       RowBox[{"MdagM", " ", "=", " ", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"i", " ", ">", " ", "j"}], " ", "||", " ", 
             RowBox[{
              RowBox[{"colorf", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "==", " ", 
              "0"}]}], ",", " ", "0", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Dependent colour sub-amplitude \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{
                 RowBox[{"Overscript", "[", 
                  RowBox[{"A", ",", " ", "\"\<\[Tilde]\>\""}], "]"}], ",", 
                 " ", "i", ",", " ", "j"}], "]"}], " ", ",", 
               " ", "\"\< computation...\>\""}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"contrparts", "=", 
              RowBox[{"splitInN", "[", 
               RowBox[{
                RowBox[{"List", "@@", 
                 RowBox[{"contrM", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ",", 
                RowBox[{"(*", "npart", "*)"}], "10"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"ti", " ", "=", " ", 
              RowBox[{"AbsoluteTime", "[", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", "==", "j", "==", "1"}], ",", " ", 
               RowBox[{
                RowBox[{"Print", "[", 
                 
                 RowBox[{"\"\<Memory usage of the product between the \
contracted subamplitude and the conjugate one before expansion: \>\"", ",", 
                  " ", 
                  RowBox[{"ByteCount", "[", 
                   RowBox[{
                    RowBox[{"contrM", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], " ", 
                    RowBox[{"Mdag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
                  " ", "\"\< B\>\""}], "]"}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"temp", "=", 
              RowBox[{"ParallelMap", "[", 
               RowBox[{
                RowBox[{"Function", "[", 
                 RowBox[{"block", ",", 
                  RowBox[{"Module", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"partialExpr", ",", "expanded"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"partialExpr", "=", 
                    RowBox[{"Total", "[", "block", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"expanded", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Mdag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "*", "partialExpr"}], " ",
                     "//", " ", "Expand"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"expanded", " ", "//", " ", "LorentzSP"}]}]}], 
                   "]"}]}], "]"}], ",", "contrparts", ",", 
                RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", "==", "j", "==", "1"}], ",", " ", 
               RowBox[{
                RowBox[{"Print", "[", 
                 
                 RowBox[{"\"\<Memory usage of their product after expansion \
and contractions: \>\"", ",", " ", 
                  RowBox[{"ByteCount", "[", 
                   RowBox[{"Total", "[", "temp", "]"}], "]"}], ",", 
                  " ", "\"\< B\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"tf", " ", "=", " ", 
                 RowBox[{"AbsoluteTime", "[", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Print", "[", 
                 
                 RowBox[{"\"\<Time taken to expand and contract: \>\"", ",", 
                  " ", 
                  RowBox[{"tf", " ", "-", " ", "ti"}], ",", 
                  " ", "\"\< s\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]", 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"ti", " ", "=", " ", 
              RowBox[{"AbsoluteTime", "[", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"appo", " ", "=", " ", 
              RowBox[{"ParallelMap", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", " ", "//", 
                    RowBox[{"momcons", "[", 
                    RowBox[{"next", ",", " ", "1"}], "]"}]}], " ", "//", " ", 
                    "ExpandLorentz"}], " ", "//", " ", "LorentzSP"}], " ", "//",
                     " ", 
                    RowBox[{"generalizedMandelstam", "[", "next", "]"}]}], 
                   " ", "//", " ", 
                   RowBox[{"sumMandelstam", "[", "next", "]"}]}], " ", ")"}], 
