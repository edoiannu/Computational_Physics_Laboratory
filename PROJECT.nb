Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Procedura"}]}], " ", "generale", " ", "che", " ", 
     "verifica", " ", "che", " ", "le", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "-", "2"}], ")"}], "!"}], " ", "sottostrutture", " ", 
     "di", " ", "colore", " ", "siano", " ", "tra", " ", "loro", " ", "tutto",
      " ", "gauge", " ", 
     RowBox[{"invarianti", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"WardIdentity", "[", 
      RowBox[{"next_", " ", 
       RowBox[{"(*", 
        RowBox[{
        "numero", " ", "di", " ", "stati", " ", "di", " ", "polarizzazione", " ",
          "esterni"}], "*)"}], ",", "mom___"}], " ", 
      RowBox[{"(*", 
       RowBox[{"momenti", " ", "da", " ", "contrarre"}], "*)"}], "]"}], ":=", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"start", ",", "stop", ",", "M", " ", 
         RowBox[{"(*", 
          RowBox[{"contributi", " ", 
           RowBox[{"all", "'"}], "ampiezza"}], "*)"}], ",", "colorSubstruct", 
         " ", 
         RowBox[{"(*", 
          RowBox[{
          "sottostrutture", " ", "di", " ", "colore", " ", "indipendenti"}], 
          "*)"}], ",", "momlist", " ", 
         RowBox[{"(*", 
          RowBox[{"lista", " ", "dei", " ", "momenti"}], "*)"}], ",", 
         "momindices", " ", 
         RowBox[{"(*", 
          RowBox[{
          "indici", " ", "dei", " ", "momenti", " ", "da", " ", "contrarre"}],
           "*)"}], ",", "extlegs", " ", 
         RowBox[{"(*", 
          RowBox[{"gambe", " ", "esterne"}], "*)"}], ",", "result", ",", "ti",
          ",", "tf"}], "}"}], ",", 
       RowBox[{
        RowBox[{"start", "=", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<=== Ward Identity Check ===\>\"", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[RightArrow] Process: 2 \[RightArrow] \>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"next", "-", "2"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"momlist", "=", 
         RowBox[{"{", "mom", "}"}]}], " ", 
        RowBox[{"(*", 
         RowBox[{
         "lista", " ", "dei", " ", "momenti", " ", "da", " ", "contrarre"}], 
         "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"momindices", "=", 
         RowBox[{"momlist", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"p", "[", "i_", "]"}], ":>", "i"}], "}"}]}]}], " ", 
        RowBox[{"(*", 
         RowBox[{
         "indici", " ", "dei", " ", "momenti", " ", "da", " ", "contrarre"}], 
         "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"SubsetQ", "[", 
            RowBox[{
             RowBox[{"Range", "[", "next", "]"}], ",", "momindices"}], 
            "]"}]}], ",", 
          RowBox[{
           RowBox[{"MessageDialog", "[", 
            
            RowBox[{"\"\<Error: some momenta do not correspond to external \
legs.\\n\>\"", "<>", "\"\<Valid range: p[1] to p[\>\"", "<>", 
             RowBox[{"ToString", "[", "next", "]"}], "<>", "\"\<].\>\""}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"AnyTrue", "[", 
           RowBox[{
            RowBox[{"Tally", "[", "momindices", "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], "&"}]}], "]"}], ",", 
          RowBox[{
           RowBox[{
           "MessageDialog", 
            "[", "\"\<Error: duplicate momenta detected in contraction \
list.\>\"", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"M", "=", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", "//", "FeynRules"}], ")"}], "&"}], ",", 
           RowBox[{"generadiagrammi", "[", 
            RowBox[{"next", ",", "grafobase"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ti", " ", "=", " ", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"M", "=", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "//", "ExpandLorentz"}], "//", "Expand"}], "//", 
              "LorentzSPinternal"}], ")"}], "&"}], ",", "M"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tf", " ", "=", " ", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Time taken to expand and do internal contractions: \>\"",
           ",", 
          RowBox[{"tf", "-", "ti"}], ",", "\"\< s\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Memory usage after expantion and internal contractions: \
\>\"", ",", " ", 
          RowBox[{"ByteCount", "[", "M", "]"}], ",", " ", "\"\< B\>\""}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"ti", " ", "=", " ", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"colorSubstruct", "=", 
         RowBox[{"indColourSubstructures", "[", 
          RowBox[{"M", ",", "next"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tf", " ", "=", " ", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Time taken to extract the indipendent colour \
sub-amplitudes: \>\"", ",", 
          RowBox[{"tf", "-", "ti"}], ",", "\"\< s\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ti", "=", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"extlegs", "=", 
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{"SP", "[", 
            RowBox[{
             RowBox[{"p", "[", "i", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"mu", "[", "i", "]"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "momindices"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"momindices", ",", "i"}], "]"}]}], ",", 
            RowBox[{"extlegs", "=", 
             RowBox[{
              RowBox[{"SP", "[", 
               RowBox[{
                RowBox[{"e", "[", "i", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"mu", "[", "i", "]"}], "}"}]}], "]"}], " ", 
              "extlegs"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "next"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "//", 
                 RowBox[{"momcons", "[", 
                  RowBox[{"next", ",", 
                   RowBox[{"momindices", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "//", 
                "ExpandLorentz"}], "//", "Expand"}], "//", "LorentzSP"}], 
             ")"}], "&"}], ",", 
           RowBox[{"extlegs", " ", "colorSubstruct"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tf", "=", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Time taken to do external contractions after imposing \
momentum conservation: \>\"", ",", 
          RowBox[{"tf", "-", "ti"}], ",", "\"\< s\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ti", "=", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Memory usage before finale internal contractions: \>\"",
           ",", " ", 
          RowBox[{"ByteCount", "[", "result", "]"}], ",", " ", "\"\< B\>\""}],
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"#", " ", "//", 
                RowBox[{"generalizedMandelstam", "[", "next", "]"}]}], "//", 
               RowBox[{"sumMandelstam", "[", "next", "]"}]}], "//", 
              "Simplify"}], ")"}], "&"}], ",", "result"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tf", "=", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Time taken to do the final simplification after \
imposing Maldestam variables conservation: \>\"", ",", 
          RowBox[{"tf", "-", "ti"}], ",", "\"\< s\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stop", "=", 
         RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Total evaluation time: \>\"", ",", 
          RowBox[{"stop", "-", "start"}], ",", "\"\< s\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Expected result: a list of \>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"Factorial", "[", 
            RowBox[{"next", "-", "2"}], "]"}], "]"}], 
          ",", "\"\< zeros if the Ward identity is satisfied.\>\""}], "]"}], ";",
         "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"WardIdentity", "[", 
    RowBox[{"4", ",", " ", 
     RowBox[{"p", "[", "1", "]"}]}], "]"}]}]}]], "Input",
