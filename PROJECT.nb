  RowBox[{
   RowBox[{
    RowBox[{"next", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"4", ",", "9"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ngrafi", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"generagrafi", "[", 
         RowBox[{"i", ",", "grafobase"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
