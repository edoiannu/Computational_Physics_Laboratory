Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calcolo", " ", "del", " ", "numero", " ", "di", " ", "grafi", " ", "per", 
    " ", "ciascun", " ", "numero", " ", "di", " ", "punti", " ", "esterni"}], 
