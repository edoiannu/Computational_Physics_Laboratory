      RowBox[{"{", 
       RowBox[{"next", ",", "ngrafi"}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xVals", "=", "next"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yVals", "=", "ngrafi"}], ";"}], "\n", 
