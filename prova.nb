Cell["Risoluzione di un sistema lineare di equazioni", "Text",
 CellChangeTimes->{{3.951473960248304*^9, 
  3.9514739720165377`*^9}},ExpressionUUID->"2e82cae3-49e5-485a-a6a3-\
36e2f0b79b2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol3", " ", "=", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", " ", "x"}], " ", "+", " ", 
        RowBox[{"b", " ", "y"}]}], " ", "==", " ", "k1"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"c", " ", "x"}], " ", "+", " ", 
        RowBox[{"d", " ", "y"}]}], " ", "==", " ", "k2"}]}], "}"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9514739900852747`*^9, 3.951474042925392*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"948f37a7-70cd-4c19-bd81-491605a21a08"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"d", " ", "k1"}], "-", 
        RowBox[{"b", " ", "k2"}]}], 
       RowBox[{
        RowBox[{"b", " ", "c"}], "-", 
        RowBox[{"a", " ", "d"}]}]]}]}], ",", 
    RowBox[{"y", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", "k1"}], "+", 
        RowBox[{"a", " ", "k2"}]}], 
       RowBox[{
        RowBox[{"b", " ", "c"}], "-", 
        RowBox[{"a", " ", "d"}]}]]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.951474046666442*^9},
 CellLabel->
  "Out[114]=",ExpressionUUID->"0da641ce-aa6f-4390-898c-f84b966237e3"]
}, Open  ]],

