Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "mi", " ", "serve", " ", "una", " ", "funzione", " ", "che", " ", "mi", " ",
     "prenda", " ", "un", " ", "input", " ", "un", " ", "grafo", " ", "e", " ",
     "mi", " ", "restituisca", " ", "gli", " ", "impulsi", " ", "di", " ", 
    "quel", " ", "grafo"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"listaimpulsi", "[", "grafo_", "]"}], " ", ":=", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Apply", "[", 
        RowBox[{"p", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", "grafo"}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "funzione", " ", "che", " ", "genera", " ", "un", " ", "sistema", " ", 
     "di", " ", "equazioni", " ", "dalla", " ", "conservazione", " ", "dei", " ",
      "momenti", " ", "del", " ", "grafo"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"generaequazioni", "[", "grafo_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "temp", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"indici", " ", "=", " ", 
        RowBox[{"Flatten", "[", "grafo", "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "converto", " ", "a", " ", "una", " ", "semplice", " ", "lista", " ",
           "di", " ", "numeri", " ", "le", " ", "coppie", " ", "del", " ", 
          "grafo"}], ",", " ", 
         RowBox[{
         "saranno", " ", "le", " ", "etichette", " ", "di", " ", "ogni", " ", 
          "punto", " ", "del", " ", "grafo"}], ",", " ", 
         RowBox[{
         "interno", " ", "o", " ", "esterno", " ", "che", " ", "sia"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"npt", " ", "=", " ", 
        RowBox[{"Max", "[", "indici", "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"numero", " ", "di", " ", "punti", " ", "esterni"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"nvert", " ", "=", " ", 
        RowBox[{"Min", "[", "indici", "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"numero", " ", "di", " ", "vertici"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"impulsi", " ", "=", " ", 
        RowBox[{"listaimpulsi", "[", "grafo", "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
        "applichiamo", " ", "la", " ", "\"\<funzione\>\"", " ", "impulso", " ",
          "p", " ", "a", " ", "ciascuna", " ", "linea", " ", "del", " ", 
         "grafo"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"equazioni", " ", "=", " ", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"impulsivertice", " ", "=", " ", 
            RowBox[{"Join", "[", " ", 
             RowBox[{
              RowBox[{"Cases", "[", 
               RowBox[{"impulsi", ",", " ", 
                RowBox[{"p", "[", 
                 RowBox[{"_", ",", " ", "i"}], "]"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"-", 
               RowBox[{"Cases", "[", 
                RowBox[{"impulsi", ",", " ", 
                 RowBox[{"p", "[", 
                  RowBox[{"i", ",", "_"}], "]"}]}], " ", "]"}]}]}], " ", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
               "qui", " ", "cambio", " ", "il", " ", "segno", " ", "se", " ", 
                
                RowBox[{"l", "'"}], "indice", " ", "del", " ", "vertice", " ",
                 "sta", " ", "al", " ", "primo", " ", "posto"}], ",", " ", 
               RowBox[{
               "il", " ", "meno", " ", "moltiplica", " ", "ciascun", " ", 
                "degli", " ", "argomenti", " ", "della", " ", "lista"}]}], 
              "*)"}], "\[IndentingNewLine]", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"eq", " ", "=", " ", 
            RowBox[{
             RowBox[{"Apply", "[", 
              RowBox[{"Plus", ",", " ", "impulsivertice"}], "]"}], " ", "==", 
             " ", "0"}]}], ";", " ", 
           RowBox[{"(*", 
            RowBox[{"questa", " ", "riga", " ", "\[EGrave]", " ", "un", " ", 
             RowBox[{"assegnazione", ":", " ", 
              RowBox[{"assegno", " ", 
               RowBox[{"ad", " ", "'"}], 
               RowBox[{"eq", "'"}], " ", "tutto", " ", "ci\[OGrave]", " ", 
               "che", " ", "sta", " ", "a", " ", "sx", " ", 
               RowBox[{"dell", "'"}], "uguale"}]}]}], "*)"}], 
           "\[IndentingNewLine]", "eq"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "nvert", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
