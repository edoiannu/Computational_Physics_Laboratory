       "P", "*"}], "..."}], ")"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"diagramma", "[", "grafo_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "impulsiinterni", "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"inseriamo", " ", 
         RowBox[{"in", " ", "'"}], 
         RowBox[{"regole", "'"}], " ", "le", " ", "equazioni", " ", "di", " ",
          "conservazione", " ", "dei", " ", "momenti", " ", "interni"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"regole", " ", "=", " ", 
         RowBox[{"generaequazioni", "[", "grafo", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "in", " ", "queste", " ", "tre", " ", "righe", " ", "mi", " ", 
          "concentro", " ", "sulle", " ", "linee", " ", "interne"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"interne", " ", "=", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{"grafo", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i_", " ", "/;", " ", 
              RowBox[{"i", "<", "0"}]}], ",", " ", 
             RowBox[{"j_", " ", "/;", " ", 
              RowBox[{"j", "<", "0"}]}]}], "}"}]}], "]"}]}], ";", "  ", 
        RowBox[{"(*", 
         RowBox[{"prima", " ", "era", " ", 
          RowBox[{"p", "[", 
           RowBox[{
            RowBox[{"i_", " ", "/;", " ", 
             RowBox[{"i", "<", "0"}]}], ",", " ", 
            RowBox[{"j_", " ", "/;", " ", 
             RowBox[{"j", "<", "0"}]}]}], "]"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"'", 
           RowBox[{"interne", "'"}], " ", "contiene", " ", "le", " ", "linee",
            " ", "interne"}], ",", " ", 
          RowBox[{
          "date", " ", "da", " ", "coppie", " ", "di", " ", "punti", " ", 
           "negativi"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"impulsiinterni", " ", "=", " ", 
         RowBox[{
          RowBox[{"listaimpulsi", "[", " ", "interne", "]"}], " ", "/.", " ", 
          
          RowBox[{"regole", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ";", " ", 
        RowBox[{"(*", 
         RowBox[{"con", " ", "questa", " ", "riga", " ", "sostituisco", " ", 
          RowBox[{"l", "'"}], "impulso", " ", "della", " ", "linea", " ", 
          "interna", " ", "con", " ", "la", " ", "sua", " ", "legge", " ", 
          "di", " ", "conservazione", " ", "del", " ", "momento", " ", "in", " ",
           "termini", " ", "degli", " ", "impulsi", " ", "esterni"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"'", 
           RowBox[{"listaimpulsi", "'"}], " ", "esegue", " ", 
           RowBox[{"l", "'"}], "operazione", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}]}], " ", "->", " ", 
          RowBox[{"p", "[", 
           RowBox[{"i", ",", " ", "j"}], "]"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "impulsi", " ", "interni", " ", "\[EGrave]", " ", "una", " ", 
          "lista", " ", "degli", " ", "impulsi", " ", "di", " ", "ciascuna", " ",
           "linea", " ", "interna", " ", "del", " ", "grafo", " ", "in", " ", 
          "termini", " ", "dei", " ", "momenti", " ", "esterni"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"propagatori", " ", "=", " ", 
