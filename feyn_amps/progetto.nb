Cell[TextData[StyleBox["Computational Methods For Physics: my project", \
"Title"]], "Text",ExpressionUUID->"d662f00c-495d-4525-8829-9e01baef073f"],

Cell["Aims of the project:", "Text",ExpressionUUID->"da5f2ed9-3b05-434c-b5e6-491852db1ed0"],

Cell["\<\
generation of Feynman amplitudes for the scattering processes gg \[Rule] gg & \
gg \[Rule] ggg in QCD;\
\>", "Item",
 CellChangeTimes->{{3.954991237041934*^9, 
  3.954991295190178*^9}},ExpressionUUID->"65e322a6-1193-4e5d-b316-\
736ef295ac1f"],

