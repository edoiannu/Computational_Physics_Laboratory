Cell[CellGroupData[{

Cell["\<\
Each object \[OpenCurlyDoubleQuote]Prop\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]V\[CloseCurlyDoubleQuote] must be associated to the \
corresponding Feynman rules and, besides their momenta, they must depend on \
some internal charge (colour charge in the case of QCD) and internal indices \
(here Lorentz indices since gluon fields are vector fields).\
\>", "ItemNumbered",ExpressionUUID->"07fef261-6c58-49f1-8bb5-bf9c4b6fb02d"],

