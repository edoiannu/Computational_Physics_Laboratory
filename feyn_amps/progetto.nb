 CellChangeTimes->{{3.954991219539332*^9, 
  3.9549912338334723`*^9}},ExpressionUUID->"1753a365-dc5c-4ab5-9542-\
01bdeef002f8"],

Cell["Steps:", "Text",ExpressionUUID->"09a4eeff-5d4a-4917-9ff8-31f6723eda47"],

Cell[CellGroupData[{

Cell["\<\
Generation of the possible connected graphs with 2 initial states and 2 (and \
3) final states, considering a theory where in each vertex can enter 3 or 4 \
lines (for the considered processes, in QCD, the only internal lines that \
must be taken into account are the gluonic ones).\
\>", "ItemNumbered",ExpressionUUID->"69636d2c-8295-4536-afb0-95bd99aa7e2a"],

