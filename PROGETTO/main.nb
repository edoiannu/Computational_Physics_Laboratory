            "gli", " ", "elementi", " ", "comuni"}], "*)"}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "Rimuovi", " ", "la", " ", "prima", " ", "occorrenza", " ", "degli",
            " ", "elementi", " ", "comuni"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"newArg1", " ", "=", " ", 
          RowBox[{
           RowBox[{"{", "arg1", "}"}], " ", "/.", " ", "repl"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"newArg2", " ", "=", " ", 
