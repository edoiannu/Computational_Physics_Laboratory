              RowBox[{
               RowBox[{"Head", "[", "newdec", "]"}], " ", "==", " ", "Plus"}],
               ",", "\[IndentingNewLine]", 
              RowBox[{"appo", " ", "=", " ", 
               RowBox[{
                RowBox[{"newdec", " ", "/.", " ", 
                 RowBox[{"{", 
                  RowBox[{
