Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"summedIndices", " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "arg1___", "]"}], " ", 
        RowBox[{"f", "[", "arg2___", "]"}]}], "/;", 
       RowBox[{
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"{", "arg1", "}"}], ",", 
          RowBox[{"{", "arg2", "}"}]}], "]"}], "=!=", 
        RowBox[{"{", "}"}]}]}], ":>", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"common", " ", "=", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"{", "arg1", "}"}], ",", 
             RowBox[{"{", "arg2", "}"}]}], "]"}]}], ",", " ", "repl", " ", ",",
           " ", "newArg1", ",", " ", "newArg2"}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Converti", " ", "gli", " ", "argomenti", " ", "in", " ", "liste"}], 
         "*)"}], 
        RowBox[{
         RowBox[{"repl", " ", "=", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"common", "->", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"j", "[", "i", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "[", "common", "]"}]}], "}"}]}], "]"}]}], 
           "]"}]}], " ", 
