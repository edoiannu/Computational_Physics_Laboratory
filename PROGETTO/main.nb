         "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Intersection", "[", 
             RowBox[{"appo", ",", " ", "newBasis"}], "]"}], " ", "!=", " ", 
            "appo"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"count", " ", ">", " ", 
               RowBox[{"Length", "[", "jacobiRules", "]"}]}], ",", " ", 
