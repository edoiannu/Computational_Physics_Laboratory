  3.956392859172036*^9}},ExpressionUUID->"cb076bb4-0510-4273-bfe2-\
b00a0216f1b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"grafobase", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], ",", " ", 
