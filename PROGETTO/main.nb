                 RowBox[{"newdec", " ", "/.", 
                  RowBox[{"jacobiRules", "[", 
                   RowBox[{"[", "count", "]"}], "]"}]}], "//", "Expand"}], "//",
                 "sost"}], ")"}], " ", "/.", " ", "Perm"}]}], ";", 
            "\[IndentingNewLine]", 
