  3.956404382155347*^9}},ExpressionUUID->"cc8a5558-f0b8-4be9-8c12-\
a2746a5c7f92"],

Cell[CellGroupData[{

Cell[TextData[{
 "Verifica dell'identit\[AGrave] di Ward\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalM]", "Text"], 
    StyleBox["  ", "Text"], "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["\[Epsilon]", 
             SubscriptBox["\[Mu]", "1"]], "..."}], " ", 
           SubscriptBox["\[Epsilon]", 
            SubscriptBox["\[Mu]", "n"]], 
           SuperscriptBox[
            StyleBox["\[ScriptCapitalM]", "Text"], 
            RowBox[{
             RowBox[{
              SubscriptBox["\[Mu]", "1"], "..."}], " ", 
             SubscriptBox["\[Mu]", "n"]}]]}], "   ", "\[Implies]", "   ", 
          SubscriptBox["\[Epsilon]", 
           SubscriptBox["\[Mu]", "1"]]}], "..."}], 
        SubscriptBox["p", 
         SubscriptBox["\[Mu]", "i"]]}], "..."}], " ", 
      SubscriptBox["\[Epsilon]", 
       SubscriptBox["\[Mu]", "n"]], 
      SuperscriptBox[
       StyleBox["\[ScriptCapitalM]", "Text"], 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["\[Mu]", "1"], "..."}], " ", 
          SubscriptBox["\[Mu]", "i"]}], " ", "..."}], " ", 
        SubscriptBox["\[Mu]", "n"]}]]}], " ", "=", " ", "0", " "}]}], 
   TraditionalForm]], "Text",
  FormatType->TraditionalForm,ExpressionUUID->
  "632388ee-5d9f-48c2-b823-77a0e4ecec86"]
}], "Subsection",
