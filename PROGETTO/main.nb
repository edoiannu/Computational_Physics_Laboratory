Cell[TextData[{
 "Ward identity\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[ScriptCapitalM]", "Text"], 
    StyleBox["  ", "Text"], "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["\[Epsilon]", 
             SubscriptBox["\[Mu]", "1"]], "..."}], " ", 
           SubscriptBox["\[Epsilon]", 
            SubscriptBox["\[Mu]", "n"]], 
           SuperscriptBox[
            StyleBox["\[ScriptCapitalM]", "Text"], 
            RowBox[{
             RowBox[{
              SubscriptBox["\[Mu]", "1"], "..."}], " ", 
             SubscriptBox["\[Mu]", "n"]}]]}], "   ", "\[Implies]", "   ", 
          SubscriptBox["\[Epsilon]", 
           SubscriptBox["\[Mu]", "1"]]}], "..."}], 
        SubscriptBox["p", 
         SubscriptBox["\[Mu]", "i"]]}], "..."}], " ", 
      SubscriptBox["\[Epsilon]", 
       SubscriptBox["\[Mu]", "n"]], 
      SuperscriptBox[
       StyleBox["\[ScriptCapitalM]", "Text"], 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["\[Mu]", "1"], "..."}], " ", 
          SubscriptBox["\[Mu]", "i"]}], " ", "..."}], " ", 
        SubscriptBox["\[Mu]", "n"]}]]}], " ", "=", " ", "0", " "}]}], 
   TraditionalForm]], "Text",ExpressionUUID->
  "632388ee-5d9f-48c2-b823-77a0e4ecec86"]
}], "Subsection",
