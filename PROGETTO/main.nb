Cell[TextData[{
 "Un-polarized squared amplitude (gg \[Rule] gg)\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPi]", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalSigma]", 
       RowBox[{"\[Lambda]", "=", "\[PlusMinus]"}]], 
      RowBox[{
       SuperscriptBox[
        SuperscriptBox["\[Epsilon]", "*"], "\[Nu]"], "(", "\[Lambda]", ")"}], 
      
      RowBox[{
       SuperscriptBox["\[Epsilon]", "\[Mu]"], "(", "\[Lambda]", ")"}]}], "=", 
     
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["g", "\[Mu]\[Nu]"]}], "+", "  ", 
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["p", "\[Mu]"], 
         SuperscriptBox["n", "\[Nu]"]}], " ", "+", " ", 
        RowBox[{
         SuperscriptBox["p", "\[Nu]"], 
         SuperscriptBox["n", "\[Mu]"]}]}], 
       RowBox[{"p", "\[CenterDot]", "n"}]]}]}]}], TraditionalForm]], 
  "DisplayFormula",ExpressionUUID->"45a04c62-37e1-46eb-80a7-3aaff2e69141"]
}], "Subsection",
