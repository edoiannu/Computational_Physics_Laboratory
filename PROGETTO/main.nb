Cell[TextData[{
 StyleBox["QCD\n", "Title"],
 StyleBox["Calcolo del modulo quadro di ampiezze non polarizzate per processi \
gg \[Rule] gg e gg \[Rule] ggg e studio delle propriet\[AGrave] di invarianza \
di gauge\n\n", "Subtitle"],
 "Per generare con Mathematica tutti i possibili diagrammi per ciascuno dei \
due processi partiamo da un \"grafo base\" di partenza a ci attacchiamo le \
linee esterne aggiuntive in tutti i modi consentiti dalla teoria."
}], "Text",
 CellChangeTimes->{{3.956391914985772*^9, 3.9563920984231243`*^9}, {
  3.9563921314772263`*^9, 3.9563921527468233`*^9}, {3.9563924895562887`*^9, 
