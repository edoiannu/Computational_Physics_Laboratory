Cell[CellGroupData[{

Cell[TextData[{
 "Calcolo dell'ampiezza modulo quadro non ",
 Cell[BoxData[
  FormBox["polarizzata", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20207314-76e8-44b1-8a88-c6d66fa40464"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalPi]", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalSigma]", 
       RowBox[{"\[Lambda]", "=", "\[PlusMinus]"}]], 
      RowBox[{
       SuperscriptBox[
        SuperscriptBox["\[Epsilon]", "*"], "\[Nu]"], "(", "\[Lambda]", ")"}], 
      
      RowBox[{
       SuperscriptBox["\[Epsilon]", "\[Mu]"], "(", "\[Lambda]", ")"}]}], "=", 
     
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["g", "\[Mu]\[Nu]"]}], "+", "  ", 
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["p", "\[Mu]"], 
         SuperscriptBox["n", "\[Nu]"]}], " ", "+", " ", 
        RowBox[{
         SuperscriptBox["p", "\[Nu]"], 
         SuperscriptBox["n", "\[Mu]"]}]}], 
       RowBox[{"p", "\[CenterDot]", "n"}]]}]}]}], TraditionalForm]], 
  "DisplayFormula",
  FormatType->TraditionalForm,ExpressionUUID->
  "45a04c62-37e1-46eb-80a7-3aaff2e69141"]
