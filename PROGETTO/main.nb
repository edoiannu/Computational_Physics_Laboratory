            RowBox[{
             RowBox[{
              SubscriptBox["\[Mu]", "1"], "..."}], " ", 
             SubscriptBox["\[Mu]", "n"]}]]}], "   ", "\[Implies]", "   ", 
          SubscriptBox["\[Epsilon]", 
           SubscriptBox["\[Mu]", "1"]]}], "..."}], 
        SubscriptBox["p", 
         SubscriptBox["\[Mu]", "i"]]}], "..."}], " ", 
      SubscriptBox["\[Epsilon]", 
       SubscriptBox["\[Mu]", "n"]], 
