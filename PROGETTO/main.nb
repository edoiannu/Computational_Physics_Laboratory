            RowBox[{"extpol", " ", 
             RowBox[{"C", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "1", ",", " ", 
            RowBox[{"Length", "[", "colorsub", "]"}]}], "}"}]}], "]"}]}], " ",
        ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "indice", " ", "di", " ", "colonna", " ", "si", " ", "riferisce", " ",
          "ai", " ", "canali", " ", "cinematici"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"colorf", " ", "=", " ", 
        RowBox[{
         RowBox[{"colorf", " ", "/.", " ", 
          RowBox[{"reorderIndices", "[", "next", "]"}]}], "//", " ", 
         "adjRepr"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"colorfDag", "=", 
        RowBox[{"complexConjugate", "[", "colorf", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"D", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", " ", "<=", " ", "j"}], ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", "==", "j"}], ",", " ", "1", ",", " ", "2"}], 
               "]"}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"contrC", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "i"}], "]"}], "]"}], ".", 
               "colorf"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Cdag", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "j"}], "]"}], "]"}], ".", 
               "colorfDag"}], ")"}]}], ",", " ", "0"}], "]"}], ",", "  ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "1", ",", " ", 
            RowBox[{"Length", "[", "prop", "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "1", ",", " ", 
            RowBox[{"Length", "[", "prop", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"propMatr", "=", 
        RowBox[{"UpperTriangularize", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"i", " ", "j"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "prop"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "prop"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"D", " ", "=", " ", 
        RowBox[{"(*", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", "D", "]"}], ",", "0"}], "]"}], "*)"}], " ", 
        RowBox[{"Flatten", "[", "D", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"propMatr", " ", "=", " ", 
        RowBox[{"(*", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", "propMatr", "]"}], ",", " ", "0"}], "]"}], 
         "*)"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Flatten", "[", "propMatr", "]"}], " ", "//", " ", 
           "ExpandLorentz"}], " ", "//", " ", "LorentzSP"}], " ", "//", " ", 
         RowBox[{"generalizedMandelstam", "[", "next", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"D", " ", "=", " ", 
        RowBox[{"ParallelMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"#", " ", "//", " ", 
                   RowBox[{"momcons", "[", 
                    RowBox[{"next", ",", " ", "4"}], "]"}]}], " ", "//", " ", 
                  "ExpandLorentz"}], " ", "//", " ", "Expand"}], " ", "//", 
                " ", "LorentzSP"}], " ", "//", " ", "matrixProduct"}], " ", "//",
               " ", "traceOperations"}], " ", "//", " ", 
             RowBox[{"generalizedMandelstam", "[", "next", "]"}]}], ")"}], 
           "  ", "&"}], " ", ",", " ", "D", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<FinestGrained\>\""}]}], " ", 
         
         RowBox[{"(*", 
          RowBox[{"1", " ", "elemento", " ", "per", " ", "kernel"}], "*)"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"result", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               FractionBox["1", "2"], "*", 
               FractionBox["1", "8"]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "1", ",", " ", 
                RowBox[{"next", "-", "2"}]}], "}"}]}], "]"}], "*", 
            RowBox[{"(", 
             RowBox[{"propMatr", ".", "D"}], ")"}]}], " ", "//", " ", 
           RowBox[{"sumMandelstam", "[", "next", "]"}]}], " ", "//", " ", 
          "Expand"}], " ", "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"stop", "=", 
