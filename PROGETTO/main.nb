Cell[TextData[{
 "Abbiamo cos\[IGrave] ottenuto tutte le possibili ampiezze per lo scattering \
elastico di due gluoni che vediamo essere quattro: canale-s, canale-t, \
canale-u e una descritta da un vertice di interazione di quattro gluoni. E' \
proprio la presenza di questo termine aggiuntivo che garantisce che \
l'ampiezza totale del processo \[ScriptCapitalM] = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalM]", "s"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1f6eddd2-8823-48b5-8ccc-84cbde048ec0"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalM]", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "efd4e7cf-5b7e-445a-a877-6bbfd9a2d6a9"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalM]", "u"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86a066f6-ede4-4c32-9596-3b19488150be"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalM]", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f33b947c-5b3e-4705-a313-13515ae67f3b"],
 " soddisfi l'identit\[AGrave] di Ward, e che quindi sia una quantit\[AGrave] \
invariante di gauge. "
}], "Text",
 CellChangeTimes->{{3.956398009486217*^9, 3.956398039471694*^9}, {
  3.956398084645845*^9, 3.9563983045196047`*^9}, {3.9563983669740868`*^9, 
  3.9563983927867804`*^9}, {3.95639850690836*^9, 3.956398604315063*^9}, {
