        "4", " ", "termini", " ", "con", " ", "indici", " ", "negativi", " ", 
         "uguali"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"interne", " ", "=", " ", 
       RowBox[{"Cases", "[", 
        RowBox[{"grafo", ",", 
