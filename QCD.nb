     RowBox[{
      FractionBox[
       RowBox[{"Prob", "[", "4", "]"}], 
       RowBox[{"4", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["Nc", "2"], "-", "1"}], ")"}], "2"]}]], "/.", " ", 
