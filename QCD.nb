Cell["\<\
External gluons are physical gluons and gauge trasformation  leaves the \
physics unchanged, so we can choose a gauge for each of them\
\>", "Text",
 CellChangeTimes->{{3.9568959199152184`*^9, 
  3.956895979692246*^9}},ExpressionUUID->"da7e39f1-c56d-4076-ba41-\
5a0a0ee60b0a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"polsum", "[", 
    RowBox[{
     RowBox[{"p", "[", "i_", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"mu1_", ",", "mu2_"}], "}"}]}], "]"}], ":=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"SP", "[", 
      RowBox[{
       RowBox[{"{", "mu1", "}"}], ",", 
       RowBox[{"{", "mu2", "}"}]}], "]"}], "-", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"p", "[", "i", "]"}], ",", 
          RowBox[{"{", "mu1", "}"}]}], "]"}], 
        RowBox[{"SP", "[", 
         RowBox[{"n", ",", 
          RowBox[{"{", "mu2", "}"}]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"p", "[", "i", "]"}], ",", 
          RowBox[{"{", "mu2", "}"}]}], "]"}], 
        RowBox[{"SP", "[", 
         RowBox[{"n", ",", 
          RowBox[{"{", "mu1", "}"}]}], "]"}]}]}], 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p", "[", "i", "]"}], ",", "n"}], "]"}]]}], 
    RowBox[{"(*", 
     RowBox[{"+", 
      FractionBox[
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{"n", ",", "n"}], "]"}], 
        RowBox[{"SP", "[", 
         RowBox[{"p", ",", 
          RowBox[{"{", "mu1", "}"}]}], "]"}], 
        RowBox[{"SP", "[", 
         RowBox[{"p", ",", 
          RowBox[{"{", "mu2", "}"}]}], "]"}]}], 
       SuperscriptBox[
        RowBox[{"SP", "[", 
         RowBox[{"n", ",", "p"}], "]"}], "2"]]}], "*)"}], ")"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.956144642266094*^9, 3.956144722013283*^9}, {
  3.9561460825251417`*^9, 3.956146082655717*^9}, {3.956150761026717*^9, 
