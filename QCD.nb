        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Nc", "2"], "-", "1"}], ")"}]}], " ", ",", 
       RowBox[{"(*", 
        RowBox[{"Stesso", " ", "argomento"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"myDelta", "[", 
         RowBox[{"a_", ",", "a_"}], "]"}], ":>", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Nc", "2"], "-", "1"}], ")"}]}], ",", 
       RowBox[{"(*", "Traccia", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"myDelta", "[", 
         RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
        RowBox[{"0", "/;", 
         RowBox[{
          RowBox[{"i", "=!=", "j"}], "&&", 
          RowBox[{"FreeQ", "[", 
           RowBox[{
            RowBox[{"i", " ", "j"}], ",", "_Symbol"}], "]"}]}]}]}], " ", ",", 
       
       RowBox[{"(*", 
        RowBox[{
        "Argomenti", " ", "diversi", " ", "ma", " ", "solo", " ", "se", " ", 
         "non", " ", "sono", " ", "dei", " ", "simboli"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"myDelta", "[", 
          RowBox[{"a_", ",", "b_"}], "]"}], "*", "expr_"}], ":>", 
        RowBox[{"(", 
         RowBox[{"expr", "/.", " ", 
          RowBox[{"b", "->", "a"}]}], ")"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{
