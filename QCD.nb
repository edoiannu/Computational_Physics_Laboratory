Cell["Usando sottostrutture di Colore", "Text",
 CellChangeTimes->{{3.956910964952303*^9, 3.956910968463435*^9}, {
  3.957023608710396*^9, 
  3.9570236154971123`*^9}},ExpressionUUID->"0f70686c-b6e8-457a-accb-\
9c6da6ecbd88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Prob", "[", "ngluoni_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "diagrams", ",", "diagramsDagger", ",", "polarization", ",", "pairs", ",",
       "M2terms", ",", "M2", ",", "startTime", ",", "cst", ",", "cstd", ",", 
      "elapsed"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"startTime", "=", 
      RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"polarization", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{"polsum", "[", 
           RowBox[{
            RowBox[{"p", "[", "i", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"mu", "[", "i", "]"}], ",", 
              RowBox[{"nu", "[", "i", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "ngluoni"}], "}"}]}], "]"}], "//", "Expand"}], "//",
        "Contract"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Somma", " ", "polarizzazioni", " ", "esterne"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"diagrams", "=", 
      RowBox[{"Apply", "[", 
       RowBox[{"List", ",", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"generadiagrammi", "[", "ngluoni", "]"}], "]"}], "/", 
             "I"}], "//", "FeynmanRules"}], "//", "frule"}], ",", "__f"}], 
         "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "Lista", " ", "di", " ", "sottostrutture", " ", "di", " ", "colore"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nsub", "=", " ", 
      RowBox[{"Length", "[", "diagrams", "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "Quante", " ", "sottostrutte", " ", "di", " ", "colore", " ", "ho"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cstructures", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"diagrams", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"j", ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"ngluoni", "-", "2"}]}], "}"}]}], "]"}]}], "]"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nsub"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Isolo", " ", "le", " ", "f"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cst", "=", " ", 
      RowBox[{"diagrams", "/", "cstructures"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{"Isolo", " ", "i", " ", "coefficienti"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cstd", "=", 
      RowBox[{"cst", "/.", 
       RowBox[{"mu", "->", "nu"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"complesso", " ", "coniugato"}], "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"pairs", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", "j"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "nsub"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "i", ",", "nsub"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Coppie", " ", "di", " ", "indici"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"color", " ", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cstructures", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "/.", 
            RowBox[{"x", "->", "y"}]}], ")"}], 
          RowBox[{"cstructures", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nsub"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i", ",", "nsub"}], "}"}]}], "]"}], "//", 
       "fcolor"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Strutture", " ", "di", " ", "colore"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"M2", " ", "=", " ", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i", "=", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"j", "=", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"factor", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "==", "j"}], ",", "1", ",", "2"}], "]"}]}], 
              "}"}], ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"factor", " ", 
                    RowBox[{"color", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", 
                    RowBox[{"j", "-", "i", "+", "1"}]}], "]"}], "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"cst", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "polarization"}], "//", 
                    "Expand"}], "//", "Contract"}], ")"}], 
                    RowBox[{"cstd", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "//", "Expand"}], ")"}],
                  "//", "Contract"}], "//", "Mandelstam"}], ")"}], "//", 
              "Simplify"}]}], "]"}]}], "]"}], "&"}], ",", "pairs"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Calcolo", " ", "separatamente", " ", "i", " ", "contributi", " ", 
       "delle", " ", "varie", " ", "sottostrutture", " ", "di", " ", 
       "colore"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"M2", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", "M2", "]"}], "/.", 
            RowBox[{
             RowBox[{"p", "[", "4", "]"}], "->", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"p", "[", "1", "]"}]}], "-", 
              RowBox[{"p", "[", "2", "]"}], "-", 
              RowBox[{"p", "[", "3", "]"}]}]}]}], "/.", 
           RowBox[{"u", "->", 
            RowBox[{
             RowBox[{"-", "s"}], "-", "t"}]}]}], "//", "Contract"}], "//", 
         "Simplify"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"elapsed", "=", 
      RowBox[{
       RowBox[{"AbsoluteTime", "[", "]"}], "-", "startTime"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Elapsed time for 2 -> \>\"", " ", ",", 
       RowBox[{"ngluoni", "-", "2"}], ",", "\"\< gluon scattering is: \>\"", ",",
        "elapsed", ",", "\"\< seconds\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", "M2"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.956918887960881*^9, 3.956918906987142*^9}, {
   3.956920382453095*^9, 3.9569204150320473`*^9}, {3.956921683388626*^9, 
   3.9569219642178288`*^9}, {3.956922386119994*^9, 3.956922472346364*^9}, {
