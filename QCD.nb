Cell[BoxData[
 RowBox[{
  RowBox[{"Mod2", "[", "ngluoni_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "diagrams", ",", "diagramsDagger", ",", "polarization", ",", "pairs", ",",
       "M2terms", ",", "M2", ",", "startTime", ",", "elapsed", ",", 
      "diagramsWithPolarization"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"startTime", "=", 
       RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"polarization", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{"polsum", "[", 
           RowBox[{
            RowBox[{"p", "[", "i", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"mu", "[", "i", "]"}], ",", 
              RowBox[{"nu", "[", "i", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "ngluoni"}], "}"}]}], "]"}], "//", "Expand"}], "//",
        "Contract"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diagrams", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"generadiagrammi", "[", "ngluoni", "]"}], "/", "I"}], "//", 
        "FeynmanRules"}], "//", "Jacobi"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diagramsWithPolarization", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"diagrams", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "polarization"}], " ", "//", 
          "Expand"}], " ", "//", "Contract"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "ngluoni"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Pre", "-", 
       RowBox[{"multiply", " ", "polarization"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"diagramsDagger", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"diagrams", "/.", " ", 
         RowBox[{"mu", "->", "nu"}]}], "/.", " ", 
        RowBox[{
         RowBox[{"c", "[", 
          RowBox[{"i_", "/;", 
           RowBox[{"i", "<", "0"}]}], "]"}], ":>", 
         RowBox[{"b", "[", "i", "]"}]}]}], "//", "Simplify"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pairs", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", "j"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "ngluoni"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "i", ",", "ngluoni"}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Create", " ", "index", " ", "pairs", " ", "once"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Parallel", " ", "computation", " ", "with", " ", "consolidated", " ", 
       "operations"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"M2terms", "=", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i", "=", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"j", "=", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"factor", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "==", "j"}], ",", "1", ",", "2"}], "]"}]}], 
              "}"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"factor", "*", 
                    RowBox[{"diagramsWithPolarization", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], " ", ")"}], "*", 
                    RowBox[{"diagramsDagger", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "//", "Expand"}],
                  "//", "Contract"}], "//", "fcolor"}], "//", "Mandelstam"}], 
              "//", "Simplify"}]}], "]"}]}], "]"}], "&"}], ",", "pairs"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"M2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", "M2terms", "]"}], "/.", 
          RowBox[{
           RowBox[{"p", "[", "1", "]"}], "->", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"p", "[", "2", "]"}]}], "-", 
            RowBox[{"p", "[", "3", "]"}], "-", 
            RowBox[{"p", "[", "4", "]"}]}]}]}], "/.", 
         RowBox[{"u", "->", 
          RowBox[{
           RowBox[{"-", "s"}], "-", "t"}]}]}], "//", "Contract"}], "//", 
       "Simplify"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"elapsed", "=", 
      RowBox[{
       RowBox[{"AbsoluteTime", "[", "]"}], "-", "startTime"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Elapsed time for 2 -> \>\"", " ", ",", 
       RowBox[{"ngluoni", "-", "2"}], ",", "\"\< gluon scattering is: \>\"", ",",
        "elapsed", ",", "\"\< seconds\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", "diagramsWithPolarization"}]}], "]"}]}]], "Input",\

