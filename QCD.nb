          RowBox[{
           RowBox[{"i_", "/;", 
            RowBox[{"i", "<", "0"}]}], ",", 
           RowBox[{"j_", "/;", 
            RowBox[{"j", "<", "0"}]}]}], "}"}]}], "]"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"Seleziono", " ", "solo", " ", "gli", " ", "impulsi"}], "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{"impulsiinterni", "=", 
       RowBox[{
        RowBox[{"listaimpulsi", "[", "interne", "]"}], "/.", 
        RowBox[{"regole", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
