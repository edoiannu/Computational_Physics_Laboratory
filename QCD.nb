Cell[BoxData[
 RowBox[{"sol", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["9", "2"], "  ", 
     RowBox[{"(", 
      RowBox[{"3", " ", "-", " ", 
       FractionBox[
        RowBox[{"t", " ", "u"}], 
        SuperscriptBox["s", "2"]], " ", "-", " ", 
       FractionBox[
        RowBox[{"s", " ", "u"}], 
        SuperscriptBox["t", "2"]], "  ", "-", " ", 
       FractionBox[
        RowBox[{"t", " ", "s"}], 
        SuperscriptBox["u", "2"]]}], ")"}]}], "//.", 
    RowBox[{"u", "->", " ", 
     RowBox[{
      RowBox[{"-", "s"}], "-", "t"}]}]}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.9566459224804287`*^9, 3.956646016783514*^9}, {
