Cell[BoxData[
 RowBox[{
  RowBox[{"WardId", "[", 
   RowBox[{"ngluoni_", ",", "momenta_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "temp", ",", "ward", ",", "Ampiezza", ",", "colorsubstructures"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Ampiezza", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"generadiagrammi", "[", "ngluoni", "]"}], "]"}], "//", 
         "FeynmanRules"}], "//", "Jacobi"}], "//", "frule"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{"Genero", " ", 
       RowBox[{"l", "'"}], "ampiezza", " ", "come", " ", "somma", " ", "dei", 
       " ", "diagrammi"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"colorsubstructures", "=", 
      RowBox[{"Apply", "[", 
       RowBox[{"List", ",", 
        RowBox[{"Collect", "[", 
         RowBox[{"Ampiezza", " ", ",", " ", "_f"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "Isolo", " ", "le", " ", "sottostrutture", " ", "gauge", " ", 
       "invarianti"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ward", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"colorsubstructures", " ", "momenta"}], " ", "//", 
                "Expand"}], "//", "Contract"}], "//", "Mandelstam"}], ")"}], "/.",
             " ", 
            RowBox[{
             RowBox[{"p", "[", "1", "]"}], "->", " ", 
             RowBox[{"-", " ", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"p", "[", "i", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "2", ",", "4"}], "}"}]}], "]"}]}]}]}], "/.", 
           RowBox[{"u", "->", 
            RowBox[{
             RowBox[{"-", "s"}], "-", "t"}]}]}], "//", "Contract"}], "//", 
         "Physpol"}], "//", "Simplify"}], "//", "Timing"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.956891675404745*^9, 3.956891722256872*^9}, {
