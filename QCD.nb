      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "voglio", " ", "identificare", " ", "vertici", " ", "e", " ", "linee",
          " ", "interne"}], ",", " ", 
        RowBox[{
