       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"p", "[", "npt", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"p", "[", "k", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"npt", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
      " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"L", "'"}], "ultimo", " ", "impulso", " ", 
        RowBox[{"e", "'"}], " ", "meno", " ", "la", " ", "somma", " ", 
        "degli", " ", "impulsi", " ", "per", " ", "conservare", " ", 
        RowBox[{"l", "'"}], "impulso"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"equazioni", " ", "=", " ", 
       RowBox[{"equazioni", "/.", " ", "globale"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Risolvo", " ", "il", " ", "sistema", " ", "lineare"}], "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{"impulsiinterni", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{"equazioni", ",", "incognite"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "impulsiinterni", "]"}]}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"diagramma", "[", "grafo_", "]"}], ":=", " ", 
