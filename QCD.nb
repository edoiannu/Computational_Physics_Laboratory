        RowBox[{
         RowBox[{"[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "prendo", " ", "la", " ", 
         "prima", " ", "soluzione"}], ",", " ", 
        RowBox[{"tanto", " ", "il", " ", "sistema", " ", 
         RowBox[{"e", "'"}], " ", "lineare", " ", "e", " ", "ne", " ", "ha", " ",
          "uno"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "serve", " ", "anche", " ", "indiciinterni", " ", "per", " ", 
