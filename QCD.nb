         "..."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"propagatori", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Prop", "[", 
