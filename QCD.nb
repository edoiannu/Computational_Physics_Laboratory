  RowBox[{"myDelta", ",", "Orderless"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ColorDelta", "=", 
   RowBox[{
    RowBox[{"#", "//.", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"myDelta", "[", 
          RowBox[{"a_", ",", "b_"}], "]"}], 
         RowBox[{"myDelta", "[", 
