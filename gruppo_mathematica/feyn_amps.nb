  3.95369486521272*^9, 
  3.9536948725907927`*^9}},ExpressionUUID->"3c4f6e9a-61fa-4789-8fea-\
422d933db451"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{
             "prende", " ", "in", " ", "input", " ", "il", " ", "numero", " ",
               "di", " ", "punti", " ", "esterni", " ", "e", " ", 
              "restituisce", " ", "la", " ", "lista", " ", "delle", " ", 
              "strutture", " ", "V", "*", "P", "*", "V", "*", "P", "*"}], 
             "..."}], ")"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"diagramma", "[", "grafo_", "]"}], " ", ":=", " ", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "impulsiinterni", "}"}], ",", "\[IndentingNewLine]",
              "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"regole", " ", "=", " ", 
               RowBox[{"generaequazioni", "[", "grafo", "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "in", " ", "queste", " ", "tre", " ", "righe", " ", "mi", " ", 
                "concentro", " ", "sulle", " ", "linee", " ", "interne"}], 
               "*)"}], "\[IndentingNewLine]", 
              RowBox[{"interne", " ", "=", " ", 
               RowBox[{"Cases", "[", 
                RowBox[{"grafo", ",", " ", 
                 RowBox[{"p", "[", 
                  RowBox[{
                   RowBox[{"i_", " ", "/;", " ", 
                    RowBox[{"i", "<", "0"}]}], ",", " ", 
                   RowBox[{"j_", " ", "/;", " ", 
                    RowBox[{"j", "<", "0"}]}]}], "]"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"impulsiinterni", " ", "=", " ", 
               RowBox[{
                RowBox[{"listaimpulsi", "[", " ", "interne", "]"}], " ", "/.",
                 " ", 
                RowBox[{"regole", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"propagatori", " ", "=", " ", 
               RowBox[{"Map", "[", 
                RowBox[{"Prop", ",", " ", "impulsiinterni"}], " ", 
                RowBox[{"(*", 
                 RowBox[{
                 ",", " ", "indiciinterni", ",", " ", "coloriinterni", ",", 
                  " ", "caricheinterne", ",", " ", 
                  RowBox[{"ecc", "..."}]}], "*)"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"propagatori", " ", "=", " ", 
               RowBox[{"Apply", "[", 
                RowBox[{"Times", ",", " ", "propagatori"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "vediamo", " ", "come", " ", "possiamo", " ", "estrarre", " ", 
                "i", " ", "vertici"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"vertici", " ", "=", " ", 
               RowBox[{"Table", "[", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"linee", " ", "=", " ", 
                   RowBox[{"Join", "[", " ", 
                    RowBox[{
                    RowBox[{"Cases", "[", 
                    RowBox[{"grafo", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"_", ",", " ", "i"}], "}"}]}], "]"}], ",", " ", 
                    RowBox[{"Cases", "[", 
                    RowBox[{"grafo", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", " ", "_"}], "}"}]}], "]"}]}], "]"}]}], 
                  ";"}], "*)"}], "\[IndentingNewLine]", 
                RowBox[{"impulsi", " ", "=", " ", 
                 RowBox[{"listaimpulsi", "[", "grafo"}]}]}]}]}]}]}]}], "}"}], 
         ";"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"impulsivertice", " ", "=", " ", 
          RowBox[{"Join", "[", " ", 
           RowBox[{
            RowBox[{"Cases", "[", 
             RowBox[{"impulsi", ",", " ", 
              RowBox[{"p", "[", 
               RowBox[{"_", ",", " ", "i"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"-", 
             RowBox[{"Cases", "[", 
              RowBox[{"impulsi", ",", " ", 
               RowBox[{"p", "[", 
                RowBox[{"i", ",", " ", "_"}], "]"}]}], "]"}]}]}], "]"}]}], 
         ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vertice", " ", "=", " ", 
          RowBox[{
           RowBox[{"V", "[", "i", "]"}], "[", "impulsivertice", "]"}]}], 
         ";"}], "\[IndentingNewLine]", "vertice", "\[IndentingNewLine]", 
        RowBox[{",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "nvert", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]"}], "]"}], ";"}], "\[IndentingNewLine]"}], "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"generadiagrammi", "[", "n_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "temp", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"grafi", " ", "=", " ", 
