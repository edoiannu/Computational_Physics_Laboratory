Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "mi", " ", "serve", " ", "una", " ", "funzione", " ", "che", " ", "mi", " ",
     "prenda", " ", "un", " ", "input", " ", "un", " ", "grafo", " ", "e", " ",
     "mi", " ", "restituisca", " ", "gli", " ", "impulsi", " ", "di", " ", 
    "quel", " ", "grafo"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"listaimpulsi", "[", "grafo_", "]"}], " ", ":=", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Apply", "[", 
        RowBox[{"p", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", "grafo"}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"generaequazioni", "[", "grafo_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "temp", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"indici", " ", "=", " ", 
        RowBox[{"Flatten", "[", "grafo", "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
        "converto", " ", "a", " ", "lista", " ", "di", " ", "numeri"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"npt", " ", "=", " ", 
        RowBox[{"Max", "[", "indici", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nvert", " ", "=", " ", 
        RowBox[{"Min", "[", "indici", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"impulsi", " ", "=", " ", 
        RowBox[{"listaimpulsi", "[", "grafo", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"equazioni", " ", "=", " ", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"impulsivertice", " ", "=", " ", 
            RowBox[{"Join", "[", " ", 
             RowBox[{
              RowBox[{"Cases", "[", 
               RowBox[{"impulsi", ",", " ", 
                RowBox[{"p", "[", 
                 RowBox[{"_", ",", " ", "i"}], "]"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"-", 
               RowBox[{"Cases", "[", 
                RowBox[{"impulsi", ",", " ", 
                 RowBox[{"p", "[", 
                  RowBox[{"i", ",", "_"}], "]"}]}], " ", "]"}]}]}], " ", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
               "qui", " ", "cambio", " ", "il", " ", "segno", " ", "se", " ", 
                
                RowBox[{"l", "'"}], "indice", " ", "del", " ", "vertice", " ",
                 "sta", " ", "al", " ", "primo", " ", "posto"}], ",", " ", 
               RowBox[{
               "il", " ", "meno", " ", "moltiplica", " ", "ciascun", " ", 
                "degli", " ", "argomenti", " ", "della", " ", "lista"}]}], 
              "*)"}], "\[IndentingNewLine]", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"eq", " ", "=", " ", 
            RowBox[{
             RowBox[{"Apply", "[", 
              RowBox[{"Plus", ",", " ", "impulsivertice"}], "]"}], " ", "==", 
             " ", "0"}]}], ";", " ", 
           RowBox[{"(*", 
            RowBox[{"questa", " ", "riga", " ", "\[EGrave]", " ", "un", " ", 
             RowBox[{"assegnazione", ":", " ", 
              RowBox[{"assegno", " ", 
               RowBox[{"ad", " ", "'"}], 
               RowBox[{"eq", "'"}], " ", "tutto", " ", "ci\[OGrave]", " ", 
               "che", " ", "sta", " ", "a", " ", "sx", " ", 
               RowBox[{"dell", "'"}], "uguale"}]}]}], "*)"}], 
           "\[IndentingNewLine]", "eq"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "nvert", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "voglio", " ", "rinominare", " ", "i", " ", "miei", " ", "impulsi", " ",
           "come", " ", "p1"}], ",", " ", "p2", ",", " ", 
         RowBox[{"...", " ", "invece", " ", "di", " ", 
          RowBox[{"p", "[", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "]"}]}], ",", " ", 
         RowBox[{"p", "[", 
          RowBox[{"2", ",", 
           RowBox[{"-", "1"}]}], "]"}], ",", " ", 
         RowBox[{"etc", "..."}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"il", " ", 
           RowBox[{"comando", " ", "'"}]}], "/;", 
          RowBox[{"'", " ", "\[EGrave]", " ", "un", " ", "if"}]}], ",", " ", 
         RowBox[{"il", " ", "comando", " ", 
          RowBox[{"prende", " ", "'"}], 
          RowBox[{"i", "'"}], " ", "e", " ", "verifica", " ", "che", " ", 
          "sia", " ", "maggiore", " ", "di", " ", "0"}], ",", " ", 
         RowBox[{
         "e", " ", "se", " ", "lo", " ", "\[EGrave]", " ", "procede", " ", 
          "della", " ", "sostituzione", " ", "facendo", " ", "cadere", " ", 
          RowBox[{"la", " ", "'"}], 
          RowBox[{"j", "'"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"equazioni", " ", "=", " ", 
        RowBox[{"equazioni", " ", "/.", " ", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{
            RowBox[{"i_", " ", "/;", " ", 
             RowBox[{"i", ">", "0"}]}], ",", " ", "j_"}], "]"}], " ", ":>", 
          " ", 
          RowBox[{"p", "[", "i", "]"}]}]}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{
          "se", " ", "avessi", " ", "scritto", " ", "solo", " ", "la", " ", 
           "freccetta"}], " ", "->", " ", 
          RowBox[{
          "sarebbe", " ", "stata", " ", "una", " ", "semplice", " ", 
           "sostituzione", " ", "di", " ", "una", " ", "certa", " ", 
           "variabile", " ", 
           RowBox[{"p", "[", "i", "]"}], " ", 
           RowBox[{"all", "'"}], "interno", " ", 
           RowBox[{"dell", "'"}], "espressione"}]}], ",", " ", 
         RowBox[{
         "non", " ", "una", " ", "redefizione", " ", "della", " ", 
          "funzione"}]}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"incognite", " ", "=", " ", 
        RowBox[{"Cases", "[", " ", 
         RowBox[{"equazioni", ",", " ", 
          RowBox[{"p", "[", 
           RowBox[{"_", ",", " ", "_"}], "]"}], ",", " ", "Infinity"}], 
         "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"metto", " ", "'"}], 
         RowBox[{"Infinity", "'"}], " ", "perch\[EGrave]", " ", "sono", " ", 
         "pigro", " ", "e", " ", "non", " ", "ho", " ", "voglia", " ", "di", " ",
          "cercare", " ", "a", " ", "quale", " ", "livello", " ", "cercare", " ", 
         RowBox[{"p", "[", 
          RowBox[{"_", ",", "_"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"globale", " ", "=", " ", 
        RowBox[{"Rule", "[", 
         RowBox[{
          RowBox[{"p", "[", "npt", "]"}], ",", " ", 
          RowBox[{"-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"p", "[", "k", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "1", ",", " ", 
               RowBox[{"npt", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
       " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"'", 
          RowBox[{"Rule", "'"}], " ", "\[EGrave]", " ", "un", " ", "altro", " ",
           "modo", " ", "per", " ", "scrivere", " ", "la", " ", "freccetta"}],
          " ", "->"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"assegna", " ", "p1"}], " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", " ", "p2"}], " ", "-", " ", "p3", " ", "-"}], " ", 
            "..."}], " ", "-", " ", 
           RowBox[{"pk", " ", "etc"}]}], "..."}]}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"equazioni", " ", "=", " ", 
        RowBox[{"equazioni", " ", "/.", " ", "globale"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"impulsiinterni", " ", "=", " ", 
        RowBox[{"Solve", "[", 
         RowBox[{"equazioni", ",", " ", "incognite"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "impulsiinterni", "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
